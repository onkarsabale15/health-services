{
  "name": "integration-engine",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema=packages/infra/prisma/schema.prisma",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "dev": "turbo run dev --concurrency 25",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "check": "turbo run build lint",
    "check:cds-app": "turbo run build lint --filter=@hs/cds-app",
    "check:cds-ui": "turbo run build lint --filter=@hs/cds-ui",
    "check:bridge-api": "turbo run build lint --filter=@hs/bridge-api",
    "check:admin-api": "turbo run build lint --filter=@hs/admin-api",
    "check:admin-ui": "turbo run build lint --filter=@hs/admin-ui",
    "check:workflow-app": "turbo run build lint --filter=@hs/workflow-app",
    "clean": "turbo run clean",
    "clean:all": "rm -rf node_modules .turbo apps/*/node_modules apps/*/.next apps/*/.turbo apps/*/dist packages/*/node_modules packages/*/dist packages/*/.turbo && echo 'Cleaned.'",
    "setup": "npm install && npm run build",
    "commit": "npm run lint && npm run build && git add . && git commit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "bash -c 'npx tsc --noEmit 2>&1 | head -20 || true'"
    ]
  },
  "devDependencies": {
    "@nestjs/platform-express": "^11.1.17",
    "@prisma/client": "^6.4.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "axios": "^1.18.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsonata": "^2.2.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prisma": "^6.4.0",
    "sanitize-html": "^2.17.5",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "rxjs": "7.8.1",
    "@swc/helpers": "0.5.15",
    "postcss": "^8.5.3",
    "axios": "^1.18.0",
    "lodash": "^4.17.23",
    "jsonata": "^2.2.0",
    "path-to-regexp": "^8.4.0",
    "sanitize-html": "^2.17.5",
    "uuid": "^11.1.1",
    "sharp": "^0.35.0",
    "picomatch": "^4.0.4",
    "webpack": "^5.105.0",
    "protobufjs": "^7.6.5",
    "js-yaml": "^4.3.1",
    "glob": "^11.0.4",
    "next": "^16.2.11",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/auto-instrumentations-web": "^0.66.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/sdk-trace": "^2.10.0"
  }
}
