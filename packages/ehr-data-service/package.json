{
  "name": "@hs/ehr-data-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "gen:tools": "ts-node --transpile-only scripts/gen-tools.ts",
    "gen:tools:check": "npm run gen:tools && git diff --exit-code -- src/tools/tools.generated.ts",
    "build": "npm run gen:tools && tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run gen:tools:check"
  },
  "dependencies": {
    "@hs/config": "*",
    "@hs/infra": "*",
    "@medplum/fhirtypes": "^4.5.2",
    "ajv": "^8.20.0",
    "jose": "^5.6.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "ts-json-schema-generator": "^2.4.0",
    "ts-morph": "^24.0.0",
    "ts-node": "^10.9.0"
  }
}
