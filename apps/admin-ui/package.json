{
  "name": "@hs/admin-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "generate-spec": "node src/lib/sdk/scripts/generate-spec.js",
    "generate-client": "openapi-ts",
    "build": "npm run generate-spec && npm run generate-client && next build",
    "start": "next start -p 3001",
    "clean": "rm -rf .next src/lib/sdk/generated src/lib/sdk/openapi.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hs/config": "*",
    "@hs/observability": "*",
    "@hs/observability-web": "*",
    "@hey-api/client-fetch": "^0.13.1",
    "next": "^16.2.11",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@hs/admin-api": "*",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "reflect-metadata": "^0.2.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.7.0"
  }
}
