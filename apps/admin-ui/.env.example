# Admin UI — Next.js Dashboard
# Port: 3001

NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3002
NEXT_PUBLIC_WORKFLOW_UI_URL=http://localhost:3005

# Deployment environment (set alongside server-side IS_PROD in each deployment)
# true → production badge (green), false (or unset) → cert badge (yellow)
NEXT_PUBLIC_IS_PROD=false

# ─── Observability (OneUptime) ───────────────────────────────
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NEXT_PUBLIC_ONEUPTIME_TOKEN=
OTEL_SERVICE_NAME=admin-ui
