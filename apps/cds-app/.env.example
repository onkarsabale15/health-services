# CDS App — Clinical Decision Support (SMART launch + AI analysis)
# Port: 3003

# ─── Secrets (loaded from Doppler if DOPPLER_TOKEN is set) ────
# For local dev without Doppler, set these directly:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# REDISURL=redis://localhost:6379
# CDS_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Doppler (secrets management) ────────────────────────────
DOPPLER_TOKEN=
DOPPLER_PROJECT=health-services
DOPPLER_CONFIG=dev

# ─── Config (always env vars) ────────────────────────────────
PORT=3003
BRIDGE_API_URL=http://localhost:3000/api
ADMIN_API_URL=http://localhost:3002
CDS_CLIENT_ID=
CDS_FRONTEND_URL=http://localhost:3004
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3004

# ─── Deployment Environment ─────────────────────────────────
# IS_PROD=true  → production (calls prod bridge-api)
# IS_PROD=false (or unset) → cert (calls cert bridge-api)
# Used for Sentry/tracing env labels. CDS doesn't touch EHR endpoints directly.
IS_PROD=false

# ─── Observability (OneUptime) ───────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ONEUPTIME_TOKEN=
OTEL_SERVICE_NAME=cds-app
OTEL_LOG_LEVEL=info
