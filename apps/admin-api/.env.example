# Admin API — OAuth 2.0 Authorization Server + Org/User/App Management
# Port: 3002

# ─── Secrets (loaded from Doppler if DOPPLER_TOKEN is set) ────
# For local dev without Doppler, set these directly:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# REDISURL=redis://localhost:6379

# ─── Doppler (secrets management) ────────────────────────────
DOPPLER_TOKEN=
DOPPLER_PROJECT=health-services
DOPPLER_CONFIG=dev

# ─── Config (always env vars) ────────────────────────────────
PORT=3002
ADMIN_UI_URL=http://localhost:3001
WORKFLOW_UI_URL=http://localhost:3005
OAUTH_ISSUER=http://localhost:3002
JWKS_SECRET_NAME=HS_PLATFORM_JWKS_CERT

# ─── Deployment Environment ─────────────────────────────────
# IS_PROD=true  → production deployment (live EHR endpoints)
# IS_PROD=false (or unset) → cert deployment (sandbox EHR endpoints for integration testing)
IS_PROD=false

# ─── Observability (OneUptime) ───────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ONEUPTIME_TOKEN=
OTEL_SERVICE_NAME=admin-api
OTEL_LOG_LEVEL=info
