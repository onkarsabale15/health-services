# Workflow App — Visual workflow execution engine + CRUD
# Port: 3004

# ─── Secrets (loaded from Doppler if DOPPLER_TOKEN is set) ────
# For local dev without Doppler, set these directly:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# REDISURL=redis://localhost:6379
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ─── Doppler (secrets management) ────────────────────────────
DOPPLER_TOKEN=
DOPPLER_PROJECT=health-services
DOPPLER_CONFIG=dev

# ─── Config (always env vars) ────────────────────────────────
PORT=3004
OAUTH_ISSUER=http://localhost:3002
JWKS_SECRET_NAME=HS_PLATFORM_JWKS_DEV
BRIDGE_API_URL=http://localhost:3000/api
WORKFLOW_UI_URL=http://localhost:3005
ADMIN_UI_URL=http://localhost:3001
KAFKA_BROKERS=localhost:9092
# INTERNAL_API_KEY is loaded from Doppler — set directly for local dev without Doppler:
# INTERNAL_API_KEY=

# ─── AWS (for Bedrock LLM provider) ─────────────────────────
REGION=us-east-1

# ─── Observability (OneUptime) ───────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ONEUPTIME_TOKEN=
OTEL_SERVICE_NAME=workflow-app
OTEL_LOG_LEVEL=info
