# Bridge API — FHIR R4 Integration Engine + SMART Launch
# Port: 3000

# ─── Secrets (loaded from Doppler if DOPPLER_TOKEN is set) ────
# For local dev without Doppler, set these directly:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# REDISURL=redis://localhost:6379

# ─── Doppler (secrets management) ────────────────────────────
DOPPLER_TOKEN=
DOPPLER_PROJECT=health-services
DOPPLER_CONFIG=dev

# ─── Config (always env vars) ────────────────────────────────
PORT=3000
ENVIRONMENT=http://localhost:3000
OAUTH_ISSUER=http://localhost:3002
JWKS_SECRET_NAME=HS_PLATFORM_JWKS_CERT
API_KEY_SECRET=HS_BRIDGE_APIKEY_CERT

# ─── Deployment Environment ─────────────────────────────────
# IS_PROD=true  → production deployment (live EHR endpoints)
# IS_PROD=false (or unset) → cert deployment (sandbox EHR endpoints for integration testing)
IS_PROD=false
BRIDGE_API_URL=http://localhost:3000/api
REDIRECT_URI=http://localhost:3000/api/v1/callback
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3003,http://localhost:3004

# ─── AWS ─────────────────────────────────────────────────────
REGION=us-east-1
LOCALSTACK_ENDPOINT=http://localhost:4566

# ─── Observability (OneUptime) ───────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ONEUPTIME_TOKEN=
OTEL_SERVICE_NAME=bridge-api
OTEL_LOG_LEVEL=info

# NextGen: alert type ID used when writing Communication resources as alerts
# NEXTGEN_ALERT_TYPE_ID=
