# Terminology Sync — CLI-driven terminology data sync service
# Run: npm run sync -- --type icd-snomed

# ─── Secrets (loaded from Doppler if DOPPLER_TOKEN is set) ────
# For local dev without Doppler, set these directly:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Doppler (secrets management) ────────────────────────────
DOPPLER_TOKEN=
DOPPLER_PROJECT=health-services
DOPPLER_CONFIG=dev

# ─── Snowstorm API ───────────────────────────────────────────
# Override these only if using a custom Snowstorm instance:
# SNOWSTORM_BASE_URL=https://snowstorm.snomedtools.org/snowstorm/snomed-ct
# SNOWSTORM_BRANCH=MAIN

# ─── Observability (OneUptime) ───────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ONEUPTIME_TOKEN=
OTEL_SERVICE_NAME=terminology-sync
OTEL_LOG_LEVEL=info
