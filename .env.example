# ─── Secrets (loaded from Doppler if DOPPLER_TOKEN is set) ────
# For local dev without Doppler, set these directly:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# REDISURL=redis://localhost:6379
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Doppler (secrets management) ────────────────────────────
DOPPLER_TOKEN=
DOPPLER_PROJECT=health-services
DOPPLER_CONFIG=dev

# ─── Server ──────────────────────────────────────────────────
# bridge-api: 3000 | admin-ui: 3001 | admin-api: 3002 | cds-app: 3003 | workflow-app: 3004 | workflow-ui: 3005 | docs: 3006 | cds-ui: 3007
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ─── Auth ────────────────────────────────────────────────────
# All services use HS_PLATFORM_JWKS for JWT signing/verification/encryption.
# The JWKS secret is loaded dynamically from Doppler/AWS Secrets Manager as 'HS_PLATFORM_JWKS'.
OAUTH_ISSUER=http://localhost:3002

# ─── Bridge API ─────────────────────────────────────────────
BRIDGE_API_URL=http://localhost:3000/api
REDIRECT_URI=http://localhost:3000/api/v1/callback
ENVIRONMENT=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3005,http://localhost:3007

# ─── Admin UI ───────────────────────────────────────────────
ADMIN_UI_URL=http://localhost:3001

# ─── CDS App ────────────────────────────────────────────────
ADMIN_API_URL=http://localhost:3002
CDS_CLIENT_ID=
CDS_FRONTEND_URL=http://localhost:3007

# ─── Workflow App ──────────────────────────────────────────
WORKFLOW_UI_URL=http://localhost:3005
KAFKA_BROKERS=localhost:9092

# ─── Workflow UI ───────────────────────────────────────────
NEXT_PUBLIC_WORKFLOW_API_URL=http://localhost:3004
NEXT_PUBLIC_ADMIN_UI_URL=http://localhost:3001

# ─── AWS ─────────────────────────────────────────────────────
REGION=us-east-1
S3_KMS_ARN=
PLATFORM_AUDIT_LOGS_S3_BUCKET=
LOCALSTACK_ENDPOINT=http://localhost:4566

# ─── Supabase Storage (S3-compatible, used by CDS for PDF export) ──
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=care-plan-pdfs
SUPABASE_STORAGE_REGION=us-east-1
PDF_SIGNED_URL_TTL=3600

# ─── Observability (OneUptime) ───────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ONEUPTIME_TOKEN=
OTEL_SERVICE_NAME=health-services
OTEL_LOG_LEVEL=info

# Frontend (Next.js apps — must be NEXT_PUBLIC_ prefixed)
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NEXT_PUBLIC_ONEUPTIME_TOKEN=
